PORT=8889
SESSION_SECRET=change-me-to-random-secret

# LINE Messaging API (outbound push only)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_GROUP_ID=your-line-group-id

# AquaDAT endpoints (from LL_AaaS_For_DEV_Rev01.docx)
AQUADAT_REST_BASE=http://aquadat.mwa.co.th:12007
AQUADAT_GRAPHQL_URL=https://aquadat.mwa.co.th/graphql

# Daily Report auto-run (Uroboros labventure.dailyreport) — shared secret sent as X-Auto-Key.
# Set the same value in Uroboros env LABVENTURE_AUTO_KEY. Empty = auto-run disabled.
DAILY_AUTO_KEY=
